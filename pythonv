# UTILITARIOS
# =============================================================================

def texto(valor: Any) -> str:
    if valor is None:
        return ""
    try:
        if pd.isna(valor):
            return ""
    except (TypeError, ValueError):
        pass
    return re.sub(r"\s+", " ", str(valor).replace("\u00A0", " ")).strip()

def sem_acentos(valor: Any) -> str:
    return "".join(
        caractere
        for caractere in unicodedata.normalize("NFD", texto(valor))
        if unicodedata.category(caractere) != "Mn"
    ).lower()

def texto_chave(valor: Any) -> str:
    valor_normalizado = sem_acentos(valor).upper()
    valor_normalizado = valor_normalizado.replace("&", "E")
    return re.sub(r"[^A-Z0-9]", "", valor_normalizado)

def normalizar_cnpj(valor: Any) -> str:
    if valor is None:
        return ""
    try:
        if pd.isna(valor):
            return ""
    except (TypeError, ValueError):
        pass
    if isinstance(valor, float) and not isinstance(valor, bool):
        if valor.is_integer():
            return str(int(valor)).zfill(14)
        return f"{valor:.0f}".zfill(14)
    if isinstance(valor, int) and not isinstance(valor, bool):
        return str(valor).zfill(14)
    valor_texto = texto(valor)
    if "e" in valor_texto.lower():
        try:
            valor_float = float(valor_texto)
            if valor_float.is_integer():
                return f"{int(valor_float):014d}"
        except ValueError:
            pass
    if re.fullmatch(r"\d+\.0+", valor_texto):
        return valor_texto.split(".")[0].zfill(14)
    digitos = re.sub(r"\D", "", valor_texto)
    if len(digitos) <= 14:
        return digitos.zfill(14)
    return digitos[:14]

def formatar_cnpj(valor: Any) -> str:
    cnpj = normalizar_cnpj(valor)
    if len(cnpj) != 14:
        return texto(valor)
    return f"{cnpj[:2]}.{cnpj[2:5]}.{cnpj[5:8]}/{cnpj[8:12]}-{cnpj[12:]}"

def numero(valor: Any) -> Decimal | None:
    if valor is None:
        return None
    try:
        if pd.isna(valor):
            return None
    except (TypeError, ValueError):
        pass
    if isinstance(valor, Decimal):
        return valor.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    if isinstance(valor, int) and not isinstance(valor, bool):
        return Decimal(valor).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    if isinstance(valor, float) and not isinstance(valor, bool):
        return Decimal(str(valor)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    valor_texto = texto(valor).replace("R$", "").replace(" ", "")
    if not valor_texto:
        return None
    valor_texto = re.sub(r"[^\d,.\-]", "", valor_texto)
    if "," in valor_texto:
        valor_texto = valor_texto.replace(".", "").replace(",", ".")
    try:
        return Decimal(valor_texto).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
    except (InvalidOperation, ValueError):
        return None

def valor_para_excel(valor: Decimal | None) -> float | None:
    return float(valor) if valor is not None else None

def normalizar_imposto(valor: Any) -> str:
    imposto = sem_acentos(valor).upper()
    aliases = {
        "IRRF": "IRRF",
        "IMPOSTO DE RENDA RETIDO": "IRRF",
        "IMPOSTO DE RENDA RETIDO NA FONTE": "IRRF",
        "CSRF": "CSRF",
        "PCC": "CSRF",
        "PIS COFINS CSLL": "CSRF",
        "PIS/COFINS/CSLL": "CSRF",
        "PIS COFINS": "CSRF",
        "INSS": "INSS",
    }
    return aliases.get(imposto, imposto)

def normalizar_codigo(valor: Any) -> str:
    encontrado = re.search(r"\b(\d{4})\b", texto(valor))
    return encontrado.group(1) if encontrado else ""

def normalizar_periodo(valor: Any) -> str:
    valor_normalizado = re.sub(r"\s+", "", sem_acentos(valor))
    encontrado = re.search(
        r"\b("
        r"janeiro|fevereiro|marco|abril|maio|junho|"
        r"julho|agosto|setembro|outubro|novembro|dezembro"
        r")[/-](\d{4})\b",
        valor_normalizado,
    )
    if encontrado:
        mes, ano = encontrado.groups()
        return f"{ano}-{MESES[mes]}"
    encontrado = re.search(r"\b(\d{4})[/-]("
        r"janeiro|fevereiro|marco|abril|maio|junho|"
        r"julho|agosto|setembro|outubro|novembro|dezembro"
        r")\b", valor_normalizado)
    if encontrado:
        ano, mes = encontrado.groups()
        return f"{ano}-{MESES[mes]}"
    encontrado = re.search(r"\b(\d{1,2})[/-](\d{4})\b", valor_normalizado)
    if encontrado:
        mes, ano = encontrado.groups()
        return f"{ano}-{mes.zfill(2)}"
    encontrado = re.search(r"\b(\d{4})[/-](\d{1,2})\b", valor_normalizado)
    if encontrado:
        ano, mes = encontrado.groups()
        return f"{ano}-{mes.zfill(2)}"
    return ""

def periodo_exibicao(periodo: str) -> str:
    encontrado = re.fullmatch(r"(\d{4})-(\d{2})", texto(periodo))
    if not encontrado:
        return texto(periodo)
    ano, mes = encontrado.groups()
    return f"{MESES_EXIBICAO.get(mes, mes)}/{ano}"

def construir_chave(
    agente: str,
    imposto: str,
    empresa: str,
    periodo: str,
    valor: Decimal | None,
    cnpj: str | None = None,
) -> tuple[str, str, str, str, Decimal, str] | None:
    if not agente or not imposto or not empresa or not periodo or valor is None:
        return None
    cnpj_norm = normalizar_cnpj(cnpj or "")
    return (
        texto_chave(agente),
        normalizar_imposto(imposto),
        texto_chave(empresa),
        normalizar_periodo(periodo),
        valor.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP),
        cnpj_norm,
    )

def construir_chave_sem_valor(
    agente: str,
    imposto: str,
    empresa: str,
    periodo: str,
    cnpj: str | None = None,
) -> tuple[str, str, str, str, str] | None:
    if not agente or not imposto or not empresa or not periodo:
        return None
    cnpj_norm = normalizar_cnpj(cnpj or "")
    return (
        texto_chave(agente),
        normalizar_imposto(imposto),
        texto_chave(empresa),
        normalizar_periodo(periodo),
        cnpj_norm,
    )

# =============================================================================
# PARSE DO NOME DO ARQUIVO
# =============================================================================

def extrair_imposto_e_codigo_do_nome(nome_imposto: str) -> tuple[str, str]:
    nome = texto(nome_imposto)
    codigo = ""
    m = re.search(r"\b(\d{4})\b", nome)
    if m:
        codigo = m.group(1)
        nome = nome.replace(codigo, "").strip()
    imposto = normalizar_imposto(nome)
    return imposto, codigo

def extrair_periodo_do_nome(partes: list[str]) -> str:
    padrao_periodo = re.compile(r"^\d{1,2}[./-]\d{4}$")
    for i in range(len(partes) - 1, max(len(partes) - 4, -1), -1):
        if padrao_periodo.match(partes[i]):
            return partes[i]
    return ""

def parse_nome_arquivo(nome_arquivo: str) -> dict[str, str]:
    nome = Path(nome_arquivo).stem
    partes = [parte.strip() for parte in nome.split("-")]
    if len(partes) < 4:
        return {"agente": "", "imposto": "", "empresa": "", "periodo": ""}
    agente = texto_chave(partes[0])
    imposto_bruto = partes[1]
    imposto, _ = extrair_imposto_e_codigo_do_nome(imposto_bruto)
    periodo_nome = extrair_periodo_do_nome(partes)
    if periodo_nome:
        periodo_idx = partes.index(periodo_nome)
        empresa_partes = partes[2:periodo_idx]
    else:
        empresa_partes = partes[2:-1]
    empresa = "-".join(empresa_partes) if empresa_partes else ""
    periodo = periodo_nome if periodo_nome else partes[-1]
    return {"agente": agente, "imposto": imposto, "empresa": empresa, "periodo": periodo}

