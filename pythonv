@dataclass
class GuiaPDF:
    arquivo_pdf: str
    caminho_pdf: Path
    imposto: str
    agente: str
    empresa: str
    periodo: str
    valor_pdf: Decimal | None
    codigo_pdf: str
    cnpj: str = ""
    codigos_inss: list[str] = field(default_factory=list)
    valores_inss: list[Decimal] = field(default_factory=list)
    observacoes: list[str] = field(default_factory=list)

