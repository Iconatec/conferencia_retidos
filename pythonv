def caminho_recurso(nome_arquivo: str) -> Path:
    if getattr(sys, "frozen", False):
        return Path(sys._MEIPASS) / nome_arquivo
    return Path(__file__).resolve().parent / nome_arquivo

def aplicar_icone_janela(janela: ctk.CTk) -> None:
    caminho_ico = caminho_recurso("icone.ico")
    if caminho_ico.exists():
        try:
            janela.iconbitmap(default=str(caminho_ico))
        except Exception:
            pass

