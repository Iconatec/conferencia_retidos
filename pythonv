def localizar_pdfs(pasta_raiz: Path) -> list[Path]:
    pdfs: list[Path] = []
    for imposto in sorted(IMPOSTOS_VALIDOS):
        pasta_imposto = pasta_raiz / imposto
        if not pasta_imposto.exists():
            print(f"Aviso: subpasta nao encontrada e sera ignorada: {pasta_imposto}")
            continue
        if not pasta_imposto.is_dir():
            print(f"Aviso: o caminho nao e uma pasta e sera ignorada: {pasta_imposto}")
            continue
        pdfs.extend(
            arquivo
            for arquivo in pasta_imposto.rglob("*")
            if arquivo.is_file() and arquivo.suffix.lower() == ".pdf"
        )
    return sorted(pdfs)

def obter_imposto_da_subpasta(caminho_pdf: Path, pasta_raiz: Path) -> str:
    try:
        partes_relativas = caminho_pdf.resolve().relative_to(pasta_raiz.resolve()).parts
    except ValueError:
        partes_relativas = caminho_pdf.parts
    for parte in partes_relativas[:-1]:
        imposto = normalizar_imposto(parte)
        if imposto in IMPOSTOS_VALIDOS:
            return imposto
    return ""

def extrair_texto_pdf(caminho_pdf: Path) -> str:
    if pdfplumber is not None:
        with pdfplumber.open(caminho_pdf) as pdf:
            return "\n".join(pagina.extract_text() or "" for pagina in pdf.pages)
    if fitz is not None:
        documento = fitz.open(caminho_pdf)
        try:
            return "\n".join(pagina.get_text() for pagina in documento)
        finally:
            documento.close()
    raise RuntimeError("Nenhuma biblioteca de PDF disponivel. Instale pdfplumber ou pymupdf.")

def capturar(texto_pdf: str, padrao: str, grupo: int = 1) -> str:
    encontrado = re.search(padrao, texto_pdf, flags=re.IGNORECASE | re.DOTALL)
    return texto(encontrado.group(grupo)) if encontrado else ""

def extrair_periodo(texto_pdf: str) -> str:
    encontrado = re.search(
        r"\b(janeiro|fevereiro|mar[çc]o|abril|maio|junho|julho|agosto|"
        r"setembro|outubro|novembro|dezembro)\s*/\s*(\d{4})\b",
        texto_pdf,
        flags=re.IGNORECASE,
    )
    if not encontrado:
        return ""
    return f"{encontrado.group(2)}-{MESES[sem_acentos(encontrado.group(1))]}"

def extrair_cnpj(texto_pdf: str) -> str:
    """Extrai o primeiro CNPJ no formato XX.XXX.XXX/XXXX-XX."""
    padrao = r"\b(\d{2}\.\d{3}\.\d{3}/\d{4}-\d{2})\b"
    encontrado = re.search(padrao, texto_pdf)
    return texto(encontrado.group(1)) if encontrado else ""

def extrair_codigo_principal(texto_pdf: str) -> str:
    padroes = [
        r"Composi[çc][ãa]o\s+do\s+Documento\s+de\s+Arrecada[çc][ãa]o[\s\S]{0,250}?\b(\d{4})\b",
        r"C[óo]digo\s+Principal[\s:.-]*(\d{4})\b",
    ]
    for padrao in padroes:
        codigo = normalizar_codigo(capturar(texto_pdf, padrao))
        if codigo:
            return codigo
    encontrados = re.findall(r"\b(1708|3280|5952|1162|8045)\b", texto_pdf)
    return encontrados[0] if encontrados else ""

def extrair_valor_guia_nao_inss(texto_pdf: str) -> Decimal | None:
    padroes = [
        r"C[óo]digo\s+Principal[\s\S]{0,220}?(\d{1,3}(?:\.\d{3})*,\d{2})",
        r"Valor\s+Total\s+do\s+Documento[\s\S]{0,150}?(\d{1,3}(?:\.\d{3})*,\d{2})",
    ]
    for padrao in padroes:
        valor = numero(capturar(texto_pdf, padrao))
        if valor is not None:
            return valor
    return None

def _extrair_linhas_de_bloco(bloco: str) -> tuple[list[str], list[Decimal]]:
    codigos: list[str] = []
    valores: list[Decimal] = []
    for linha in [linha.strip() for linha in bloco.splitlines() if linha.strip()]:
        codigo_encontrado = re.search(r"\b(\d{4})\b", linha)
        if not codigo_encontrado:
            continue
        codigo = codigo_encontrado.group(1)
        if codigo in {"2026", "2025", "2024", "2023", "2022"}:
            continue
        valores_texto = re.findall(r"\b\d{1,3}(?:\.\d{3})*,\d{2}\b", linha)
        if not valores_texto:
            continue
        valor = numero(valores_texto[0])
        if valor is not None:
            codigos.append(codigo)
            valores.append(valor)
    return codigos, valores

def _extrair_linhas_inss_fallback(texto_pdf: str) -> tuple[list[str], list[Decimal]]:
    codigos: list[str] = []
    valores: list[Decimal] = []
    padrao = re.compile(r"\b1162\b[\s\S]{0,150}?(\d{1,3}(?:\.\d{3})*,\d{2})", re.IGNORECASE)
    for match in padrao.finditer(texto_pdf):
        valor = numero(match.group(1))
        if valor is not None:
            codigos.append("1162")
            valores.append(valor)
    return codigos, valores

def extrair_linhas_inss(texto_pdf: str) -> tuple[list[str], list[Decimal]]:
    codigos: list[str] = []
    valores: list[Decimal] = []
    padrao_inicio = re.compile(r"Composi[çc][ãa]o\s+do\s+Documento\s+de\s+Arrecada[çc][ãa]o", re.IGNORECASE)
    padroes_fim = re.compile(r"(?:Total\s+(?:a\s+)?Pagar|Valor\s+Total\s+do\s+Documento|Autentica[çc][ãa]o|Observa[çc][õo]es|Codigo\s+de\s+Autentica[çc][ãa]o)", re.IGNORECASE)
    indices_inicio = [match.start() for match in padrao_inicio.finditer(texto_pdf)]
    if not indices_inicio:
        return _extrair_linhas_inss_fallback(texto_pdf)
    for indice_inicio in indices_inicio:
        bloco = texto_pdf[indice_inicio:]
        match_fim = padroes_fim.search(bloco)
        if match_fim:
            bloco = bloco[:match_fim.start()]
        codigos_bloco, valores_bloco = _extrair_linhas_de_bloco(bloco)
        codigos.extend(codigos_bloco)
        valores.extend(valores_bloco)
    if len(codigos) > 1:
        codigos_unicos = [codigos[0]]
        valores_unicos = [valores[0]]
        for indice in range(1, len(codigos)):
            if codigos[indice] != codigos[indice - 1] or valores[indice] != valores[indice - 1]:
                codigos_unicos.append(codigos[indice])
                valores_unicos.append(valores[indice])
        return codigos_unicos, valores_unicos
    return codigos, valores

def extrair_valor_total_inss(texto_pdf: str) -> Decimal | None:
    padroes = [
        r"Valor\s+Total\s+do\s+Documento[\s\S]{0,150}?(\d{1,3}(?:\.\d{3})*,\d{2})",
        r"Total\s+a\s+Pagar[\s\S]{0,150}?(\d{1,3}(?:\.\d{3})*,\d{2})",
        r"Total\s+do\s+Documento[\s\S]{0,150}?(\d{1,3}(?:\.\d{3})*,\d{2})",
    ]
    for padrao in padroes:
        valor = numero(capturar(texto_pdf, padrao))
        if valor is not None:
            return valor
    return None

def extrair_pdf(caminho_pdf: Path, pasta_raiz: Path) -> GuiaPDF:
    imposto_subpasta = obter_imposto_da_subpasta(caminho_pdf, pasta_raiz)
    texto_pdf = extrair_texto_pdf(caminho_pdf)
    dados_nome = parse_nome_arquivo(caminho_pdf.name)
    guia = GuiaPDF(
        arquivo_pdf=caminho_pdf.name,
        caminho_pdf=caminho_pdf,
        imposto=imposto_subpasta or dados_nome["imposto"],
        agente=dados_nome["agente"],
        empresa=dados_nome["empresa"],
        periodo=normalizar_periodo(dados_nome["periodo"]) or extrair_periodo(texto_pdf),
        valor_pdf=None,
        codigo_pdf="",
        cnpj=extrair_cnpj(texto_pdf),
    )
    if not guia.imposto:
        guia.observacoes.append("Imposto nao identificado.")
        return guia
    codigo_esperado = CODIGOS_POR_IMPOSTO[guia.imposto]
    if guia.imposto == "INSS":
        codigos, valores = extrair_linhas_inss(texto_pdf)
        guia.codigos_inss = codigos
        guia.valores_inss = valores
        guia.codigo_pdf = ", ".join(sorted(set(codigos))) if codigos else ""
        if valores:
            guia.valor_pdf = sum(valores, Decimal("0.00"))
        else:
            guia.valor_pdf = extrair_valor_total_inss(texto_pdf)
            guia.observacoes.append("Nao foi possivel extrair as linhas do INSS; foi utilizado o valor total da guia como tentativa alternativa.")
        if not codigos:
            guia.observacoes.append("Nenhuma linha de codigo/valor foi identificada na composicao do INSS.")
        elif any(codigo not in codigo_esperado for codigo in codigos):
            guia.observacoes.append("Guia INSS possui codigo(s) diferente(s) de 1162: " + ", ".join(sorted(set(codigos))))
        return guia
    guia.codigo_pdf = extrair_codigo_principal(texto_pdf)
    guia.valor_pdf = extrair_valor_guia_nao_inss(texto_pdf)
    if not guia.codigo_pdf:
        guia.observacoes.append("Codigo principal nao identificado no PDF.")
    elif guia.codigo_pdf not in codigo_esperado:
        guia.observacoes.append(f"Codigo encontrado ({guia.codigo_pdf}) incompativel com o imposto {guia.imposto} (esperado: {', '.join(codigo_esperado)}).")
    if guia.valor_pdf is None:
        guia.observacoes.append("Valor da guia nao identificado no PDF.")
    return guia

# =============================================================================
# LEITURA DA PLANILHA
# =============================================================================

def localizar_coluna(colunas: list[str], candidatos: list[str]) -> str | None:
    mapa = {sem_acentos(coluna): coluna for coluna in colunas}
    for candidato in candidatos:
        candidato_normalizado = sem_acentos(candidato)
        if candidato_normalizado in mapa:
            return mapa[candidato_normalizado]
    for coluna in colunas:
        coluna_normalizada = sem_acentos(coluna)
        if any(sem_acentos(candidato) in coluna_normalizada for candidato in candidatos):
            return coluna
    return None

def carregar_planilha(caminho_excel: Path) -> tuple[pd.DataFrame, dict[str, str]]:
    dataframe = pd.read_excel(caminho_excel, sheet_name="Base Guias", dtype=object)
    dataframe.columns = [texto(coluna) for coluna in dataframe.columns]
    colunas = list(dataframe.columns)
    campos = {
        "agente": localizar_coluna(colunas, ["Agente"]),
        "cnpj": localizar_coluna(colunas, ["CNPJ"]),
        "valor": localizar_coluna(colunas, ["Valor Guia"]),
        "imposto": localizar_coluna(colunas, ["Imposto"]),
        "periodo": localizar_coluna(colunas, ["Periodo", "Período"]),
        "empresa": localizar_coluna(colunas, ["Empresa"]),
    }
    faltantes = [campo for campo, coluna in campos.items() if coluna is None]
    if faltantes:
        raise ValueError("Colunas nao encontradas na aba 'Base Guias': " + ", ".join(faltantes))
    return dataframe, campos  # type: ignore[return-value]

