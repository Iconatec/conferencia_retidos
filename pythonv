def motivo_codigo_invalido(guia: GuiaPDF) -> str:
    if guia.imposto not in CODIGOS_POR_IMPOSTO:
        return "Imposto nao identificado"
    codigos_esperados = CODIGOS_POR_IMPOSTO[guia.imposto]
    if guia.imposto == "INSS":
        if not guia.codigos_inss:
            return "Codigo(s) das linhas do INSS nao identificado(s)"
        codigos_diferentes = sorted(set(codigo for codigo in guia.codigos_inss if codigo not in codigos_esperados))
        if codigos_diferentes:
            return "INSS com codigos mistos: " + ", ".join(sorted(set(guia.codigos_inss)))
        return ""
    if not guia.codigo_pdf:
        return "Codigo da guia nao identificado"
    if guia.codigo_pdf not in codigos_esperados:
        return f"Codigo incompativel: encontrado {guia.codigo_pdf}, esperado {', '.join(codigos_esperados)} para {guia.imposto}"
    return ""

def guia_tem_dados_minimos(guia: GuiaPDF) -> bool:
    return bool(guia.agente and guia.imposto and guia.empresa and guia.periodo and guia.valor_pdf is not None)

def codigo_eh_valido(guia: GuiaPDF) -> bool:
    if guia.imposto not in CODIGOS_POR_IMPOSTO:
        return False
    codigos_esperados = CODIGOS_POR_IMPOSTO[guia.imposto]
    if guia.imposto == "INSS":
        return all(codigo in codigos_esperados for codigo in guia.codigos_inss)
    return guia.codigo_pdf in codigos_esperados

# =============================================================================
# CRUZAMENTO PLANILHA X PDF
# =============================================================================

def comparar(dataframe: pd.DataFrame, campos: dict[str, str], guias_pdf: list[GuiaPDF]) -> pd.DataFrame:
    colunas_saida = ["Agente", "CNPJ", "Valor Guia", "Imposto", "Periodo", "Empresa"] + COLUNAS_RESULTADO
    registros: list[dict[str, Any]] = []

    pdfs_por_chave_completa: dict[tuple[str, str, str, str, Decimal, str], list[int]] = defaultdict(list)
    pdfs_por_chave_sem_valor: dict[tuple[str, str, str, str, str], list[int]] = defaultdict(list)

    for indice_pdf, guia in enumerate(guias_pdf):
        chave_completa = construir_chave(
            guia.agente,
            guia.imposto,
            guia.empresa,
            guia.periodo,
            guia.valor_pdf,
            guia.cnpj,
        )
        if chave_completa is not None:
            pdfs_por_chave_completa[chave_completa].append(indice_pdf)

        chave_sem_valor = construir_chave_sem_valor(
            guia.agente,
            guia.imposto,
            guia.empresa,
            guia.periodo,
            guia.cnpj,
        )
        if chave_sem_valor is not None:
            pdfs_por_chave_sem_valor[chave_sem_valor].append(indice_pdf)

    usados: set[int] = set()

    for _, linha in dataframe.iterrows():
        registro: dict[str, Any] = {}
        agente_original = texto(linha[campos["agente"]])
        empresa_original = texto(linha[campos["empresa"]])
        agente = texto_chave(agente_original)
        cnpj = normalizar_cnpj(linha[campos["cnpj"]])
        valor_guia = numero(linha[campos["valor"]])
        imposto = normalizar_imposto(linha[campos["imposto"]])
        periodo = normalizar_periodo(linha[campos["periodo"]])
        empresa = texto_chave(empresa_original)

        registro["Agente"] = agente_original
        registro["CNPJ"] = formatar_cnpj(cnpj)
        registro["Valor Guia"] = valor_para_excel(valor_guia)
        registro["Imposto"] = imposto
        registro["Periodo"] = periodo_exibicao(periodo)
        registro["Empresa"] = empresa_original
        registro["Valor PDF"] = None
        registro["Diferenca"] = None
        registro["Codigo PDF"] = None
        registro["Status Final"] = "revisar"
        registro["Situacao"] = ""

        if not agente:
            registro["Situacao"] = "Agente ausente na planilha; sem cruzamento possivel"
            registros.append(registro)
            continue

        if imposto not in IMPOSTOS_VALIDOS:
            registro["Situacao"] = f"Imposto invalido ou nao reconhecido: {imposto or '(vazio)'}"
            registros.append(registro)
            continue

        if not empresa:
            registro["Situacao"] = "Empresa ausente na planilha"
            registros.append(registro)
            continue

        if not periodo:
            registro["Situacao"] = "Periodo ausente ou invalido na planilha"
            registros.append(registro)
            continue

        if valor_guia is None:
            registro["Situacao"] = "Valor Guia ausente ou invalido na planilha"
            registros.append(registro)
            continue

        chave_planilha = construir_chave(
            agente,
            imposto,
            empresa_original,
            periodo,
            valor_guia,
            cnpj,
        )

        if chave_planilha is not None:
            correspondentes = [
                indice
                for indice in pdfs_por_chave_completa.get(chave_planilha, [])
                if indice not in usados
            ]
            if len(correspondentes) == 1:
                indice_pdf = correspondentes[0]
                guia = guias_pdf[indice_pdf]
                registro["Valor PDF"] = valor_para_excel(guia.valor_pdf)
                registro["Diferenca"] = (
                    valor_para_excel(guia.valor_pdf - valor_guia)
                    if guia.valor_pdf is not None
                    else None
                )
                registro["Codigo PDF"] = guia.codigo_pdf
                erro_codigo = motivo_codigo_invalido(guia)
                if erro_codigo:
                    registro["Situacao"] = erro_codigo
                else:
                    registro["Status Final"] = "ok"
                    registro["Situacao"] = "Informacoes corretas"
                usados.add(indice_pdf)
                registros.append(registro)
                continue

        chave_sem_valor = construir_chave_sem_valor(
            agente,
            imposto,
            empresa_original,
            periodo,
            cnpj,
        )

        if chave_sem_valor is not None:
            candidatos_nao_usados = [
                indice
                for indice in pdfs_por_chave_sem_valor.get(chave_sem_valor, [])
                if indice not in usados
            ]
            if len(candidatos_nao_usados) > 1:
                soma_valores = Decimal("0.00")
                codigos_encontrados: list[str] = []
                todos_codigos_validos = True
                for indice_pdf in candidatos_nao_usados:
                    guia = guias_pdf[indice_pdf]
                    if guia.valor_pdf is not None:
                        soma_valores += guia.valor_pdf
                    if guia.codigo_pdf:
                        codigos_encontrados.append(guia.codigo_pdf)
                    if not codigo_eh_valido(guia):
                        todos_codigos_validos = False

                diferenca = soma_valores - valor_guia
                registro["Valor PDF"] = valor_para_excel(soma_valores)
                registro["Diferenca"] = valor_para_excel(diferenca)
                registro["Codigo PDF"] = ", ".join(sorted(set(codigos_encontrados)))
                if diferenca == Decimal("0.00") and todos_codigos_validos:
                    registro["Status Final"] = "ok"
                    registro["Situacao"] = "Informacoes corretas (multiplas guias)"
                elif diferenca == Decimal("0.00"):
                    registro["Situacao"] = "Soma correta, mas ha codigo incompativel"
                else:
                    registro["Situacao"] = (
                        f"Valor divergente (soma dos PDFs: {soma_valores:.2f}, planilha: {valor_guia:.2f})"
                    )
                usados.update(candidatos_nao_usados)
                registros.append(registro)
                continue

            if len(candidatos_nao_usados) == 1:
                indice_pdf = candidatos_nao_usados[0]
                guia = guias_pdf[indice_pdf]
                registro["Valor PDF"] = valor_para_excel(guia.valor_pdf)
                registro["Diferenca"] = (
                    valor_para_excel(guia.valor_pdf - valor_guia)
                    if guia.valor_pdf is not None
                    else None
                )
                registro["Codigo PDF"] = guia.codigo_pdf
                erro_codigo = motivo_codigo_invalido(guia)
                registro["Situacao"] = (
                    f"{erro_codigo}; valor tambem diverge"
                    if erro_codigo
                    else "Valor da guia divergente"
                )
                usados.add(indice_pdf)
                registros.append(registro)
                continue

        registro["Situacao"] = "Apenas planilha (PDF nao encontrado)"
        registros.append(registro)

    for indice_pdf, guia in enumerate(guias_pdf):
        if indice_pdf in usados:
            continue
        registro = {coluna: None for coluna in colunas_saida}
        registro["Agente"] = guia.agente
        registro["CNPJ"] = formatar_cnpj(guia.cnpj) if guia.cnpj else None
        registro["Valor Guia"] = None
        registro["Imposto"] = guia.imposto
        registro["Periodo"] = periodo_exibicao(guia.periodo)
        registro["Empresa"] = guia.empresa
        registro["Valor PDF"] = valor_para_excel(guia.valor_pdf)
        registro["Diferenca"] = None
        registro["Codigo PDF"] = guia.codigo_pdf
        registro["Status Final"] = "revisar"
        erro_codigo = motivo_codigo_invalido(guia)
        if erro_codigo:
            registro["Situacao"] = f"Apenas PDF; {erro_codigo}"
        elif not guia_tem_dados_minimos(guia):
            registro["Situacao"] = "Apenas PDF; dados insuficientes para cruzamento"
        else:
            registro["Situacao"] = "Apenas PDF (nao encontrado na planilha)"
        registros.append(registro)

    return pd.DataFrame(registros, columns=colunas_saida)

# =============================================================================
# GERACAO DO ARQUIVO EXCEL
# =============================================================================

def salvar_resultado(resultado: pd.DataFrame, caminho_excel_original: Path) -> Path:
    caminho_saida = caminho_excel_original.parent / "resultado_conferencia_retidos.xlsx"
    with pd.ExcelWriter(caminho_saida, engine="openpyxl") as writer:
        resultado.to_excel(writer, index=False, sheet_name="Base Guias")
        planilha = writer.book["Base Guias"]
        planilha.freeze_panes = "A2"
        planilha.auto_filter.ref = planilha.dimensions
        cabecalho = {texto(celula.value): celula.column for celula in planilha[1]}
        for nome_coluna in ["Valor Guia", "Valor PDF", "Diferenca"]:
            indice_coluna = cabecalho.get(nome_coluna)
            if indice_coluna:
                for linha in range(2, planilha.max_row + 1):
                    planilha.cell(linha, indice_coluna).number_format = "#,##0.00"
        coluna_status = cabecalho.get("Status Final")
        if coluna_status:
            from openpyxl.styles import PatternFill
            preenchimento_ok = PatternFill(fill_type="solid", fgColor="C6EFCE")
            preenchimento_revisar = PatternFill(fill_type="solid", fgColor="FFC7CE")
            for linha in range(2, planilha.max_row + 1):
                celula = planilha.cell(linha, coluna_status)
                if texto(celula.value).lower() == "ok":
                    celula.fill = preenchimento_ok
                elif texto(celula.value).lower() == "revisar":
                    celula.fill = preenchimento_revisar
        for coluna in planilha.columns:
            maior_tamanho = max(
                len("" if celula.value is None else str(celula.value))
                for celula in coluna
            )
            planilha.column_dimensions[coluna[0].column_letter].width = min(maior_tamanho + 2, 65)
    return caminho_saida

# =============================================================================
# ORQUESTRACAO COM PROGRESSO
# =============================================================================

def executar_com_progresso(
    pasta_raiz: Path,
    caminho_excel: Path,
    callback_progresso: Callable[[int, int, str], None] | None = None,
) -> tuple[Path, int]:
    pdfs = localizar_pdfs(pasta_raiz)
    if not pdfs:
        raise FileNotFoundError("Nenhum PDF encontrado nas subpastas IRRF, CSRF e INSS.")
    total = len(pdfs)
    guias_pdf: list[GuiaPDF] = []
    for indice, caminho_pdf in enumerate(pdfs, start=1):
        if callback_progresso:
            callback_progresso(indice - 1, total, caminho_pdf.name)
        try:
            guias_pdf.append(extrair_pdf(caminho_pdf, pasta_raiz))
        except Exception as erro:
            imposto = obter_imposto_da_subpasta(caminho_pdf, pasta_raiz)
            guias_pdf.append(
                GuiaPDF(
                    arquivo_pdf=caminho_pdf.name,
                    caminho_pdf=caminho_pdf,
                    imposto=imposto,
                    agente="",
                    empresa="",
                    periodo="",
                    valor_pdf=None,
                    codigo_pdf="",
                    observacoes=[f"Erro ao extrair o PDF: {erro}"],
                )
            )
        if callback_progresso:
            callback_progresso(indice, total, caminho_pdf.name)
    dataframe, campos = carregar_planilha(caminho_excel)
    resultado = comparar(dataframe, campos, guias_pdf)
    return salvar_resultado(resultado, caminho_excel), total

def resolver_caminho_excel(caminho_informado: Path) -> Path:
    if caminho_informado.is_file():
        return caminho_informado
    if caminho_informado.is_dir():
        candidatos = sorted(
            arquivo
            for arquivo in caminho_informado.iterdir()
            if arquivo.is_file()
            and arquivo.suffix.lower() in {".xlsx", ".xls"}
            and sem_acentos(arquivo.stem).startswith("apuracao-retidos")
        )
        if candidatos:
            return candidatos[0]
        raise FileNotFoundError(
            "Nenhum arquivo Excel iniciado por 'Apuracao-retidos' foi encontrado na pasta: "
            f"{caminho_informado}"
        )
    raise FileNotFoundError(f"Caminho nao encontrado: {caminho_informado}")

