        self.botao_tema.configure(text="☀ Claro" if self.modo_escuro else "☾ Escuro")

    def selecionar_pasta_raiz(self) -> None:
        pasta = filedialog.askdirectory(title="Selecione a pasta raiz das guias", initialdir=self.pasta_raiz.get() or str(Path.home()))
        if pasta:
            self.pasta_raiz.set(pasta)
            self.resultado.set("")
            self.botao_abrir.configure(state="disabled")

    def selecionar_arquivo_excel(self) -> None:
        arquivo = filedialog.askopenfilename(
            title="Selecione o arquivo Apuração-retidos.xlsx",
            initialdir=str(Path(self.caminho_excel.get()).parent) if self.caminho_excel.get() else str(Path.home()),
            filetypes=[("Arquivos Excel", "*.xlsx *.xls"), ("Todos os arquivos", "*.*")],
        )
        if arquivo:
            self.caminho_excel.set(arquivo)
            self.resultado.set("")
            self.botao_abrir.configure(state="disabled")

    def iniciar_processamento(self) -> None:
        pasta_raiz = Path(self.pasta_raiz.get().strip())
        caminho_excel = Path(self.caminho_excel.get().strip().strip('"'))
        if not pasta_raiz.is_dir():
            messagebox.showerror("Pasta inválida", "Selecione uma pasta raiz válida.")
            return
        if not caminho_excel.is_file():
            messagebox.showerror("Arquivo inválido", "Selecione um arquivo Excel válido.")
            return
        for botao in [self.botao_processar, self.botao_selecionar_pasta, self.botao_selecionar_excel, self.botao_abrir]:
            botao.configure(state="disabled")
        self.resultado.set("")
        self.label_resultado.configure(text_color=(self.VERDE, "#4ADE80"))
        self.progresso.set(0)
        self.percentual.set("0%")
        self.status.set("Preparando processamento...")
        threading.Thread(target=self.processar_guias, args=(pasta_raiz, caminho_excel), daemon=True).start()

    def atualizar_progresso(self, atual: int, total: int, nome_arquivo: str) -> None:
        percentual = int((atual / total) * 100) if total else 0
        self.progresso.set(atual / total if total else 0)
        self.percentual.set(f"{percentual}%")
        self.status.set(f"Processando {atual} de {total}: {nome_arquivo}")

    def processar_guias(self, pasta_raiz: Path, caminho_excel: Path) -> None:
        try:
            def callback(atual: int, total: int, nome: str) -> None:
                self.raiz.after(0, lambda: self.atualizar_progresso(atual, total, nome))
            self.raiz.after(0, lambda: self.status.set("Lendo PDFs e planilha..."))
            caminho_saida, total = executar_com_progresso(pasta_raiz, caminho_excel, callback)
            self.arquivo_saida = caminho_saida
            self.raiz.after(0, lambda: self.finalizar_sucesso(total))
        except Exception as erro:
            self.raiz.after(0, lambda: self.finalizar_erro(str(erro)))

    def finalizar_sucesso(self, total: int) -> None:
        self.progresso.set(1)
        self.percentual.set("100%")
        self.status.set("Processamento concluído.")
        self.resultado.set(f"Concluído: {total} arquivo(s) processado(s).\nPlanilha criada: {self.arquivo_saida}")
        for botao in [self.botao_processar, self.botao_selecionar_pasta, self.botao_selecionar_excel]:
            botao.configure(state="normal")
        self.botao_abrir.configure(state="normal")
        messagebox.showinfo("Processamento concluído", f"{total} arquivo(s) processado(s).\n\nPlanilha criada com sucesso em:\n{self.arquivo_saida}")

    def finalizar_erro(self, mensagem: str) -> None:
        self.status.set("Processamento não concluído.")
        self.resultado.set(f"Erro: {mensagem}")
        self.label_resultado.configure(text_color=(self.VERMELHO, "#F87171"))
        for botao in [self.botao_processar, self.botao_selecionar_pasta, self.botao_selecionar_excel]:
            botao.configure(state="normal")
        self.botao_abrir.configure(state="disabled")
        messagebox.showerror("Erro no processamento", mensagem)

    def abrir_planilha(self) -> None:
        if self.arquivo_saida and self.arquivo_saida.exists():
            if sys.platform == "win32":
                os.startfile(self.arquivo_saida)
            elif sys.platform == "darwin":
                os.system(f'open "{self.arquivo_saida}"')
            else:
                os.system(f'xdg-open "{self.arquivo_saida}"')
        else:
            messagebox.showwarning("Planilha não encontrada", "A planilha de resultado não está disponível.")

def main() -> None:
    if sys.platform == "win32":
        ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("br.com.icona.conferencia.guias.retidos")
    ctk.set_appearance_mode("Dark")
    ctk.set_default_color_theme("blue")
    raiz = ctk.CTk()
    ConferenciaApp(raiz)
    raiz.mainloop()

if __name__ == "__main__":
    main()
