# IRRF aceita tres codigos: 1708, 3280 e 8045.
CODIGOS_POR_IMPOSTO = {
    "IRRF": ["1708", "3280", "8045"],
    "CSRF": ["5952"],
    "INSS": ["1162"],
}

IMPOSTOS_VALIDOS = set(CODIGOS_POR_IMPOSTO.keys())

MESES = {
    "janeiro": "01",
    "fevereiro": "02",
    "marco": "03",
    "abril": "04",
