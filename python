def resolver_caminho_excel(caminho_informado: Path) -> Path:
    if caminho_informado.is_file():
        return caminho_informado
    if caminho_informado.is_dir():
        candidatos = sorted(
            arquivo
            for arquivo in caminho_informado.iterdir()
            if arquivo.is_file()
            and arquivo.suffix.lower() in {".xlsx", ".xls"}
            and sem_acentos(arquivo.stem).startswith("apuracao-retidos")
        )
        if candidatos:
            return candidatos[0]
        raise FileNotFoundError(
            "Nenhum arquivo Excel iniciado por 'Apuracao-retidos' foi encontrado na pasta: "
            f"{caminho_informado}"
        )
    raise FileNotFoundError(f"Caminho nao encontrado: {caminho_informado}")


def executar(pasta_raiz: Path, caminho_excel: Path) -> Path:
    pdfs = localizar_pdfs(pasta_raiz)
    if not pdfs:
        raise FileNotFoundError("Nenhum PDF encontrado nas subpastas IRRF, CSRF e INSS.")
    print(f"PDFs encontrados: {len(pdfs)}")
    guias_pdf: list[GuiaPDF] = []
    for indice, caminho_pdf in enumerate(pdfs, start=1):
        print(f"[{indice}/{len(pdfs)}] Lendo: {caminho_pdf.name}")
        try:
            guias_pdf.append(extrair_pdf(caminho_pdf, pasta_raiz))
        except Exception as erro:
            imposto = obter_imposto_da_subpasta(caminho_pdf, pasta_raiz)
            guias_pdf.append(GuiaPDF(arquivo_pdf=caminho_pdf.name, caminho_pdf=caminho_pdf, imposto=imposto, agente="", empresa="", periodo="", valor_pdf=None, codigo_pdf="", observacoes=[f"Erro ao extrair o PDF: {erro}"]))
    dataframe, campos = carregar_planilha(caminho_excel)
    resultado = comparar(dataframe, campos, guias_pdf)
    return salvar_resultado(resultado, caminho_excel)


def main() -> None:
    print("Conferencia de guias RETIDOS - IRRF, CSRF e INSS")
    print()
    print("A pasta raiz deve conter as subpastas: IRRF, CSRF e INSS.")
    print("Os PDFs devem seguir o padrao: agente - imposto - empresa - periodo.pdf")
    print("Exemplo: 4 - CSRF - ADM - 07.2026.pdf")
    print()
    entrada_pasta = input("Caminho da pasta raiz das guias: ").strip().strip('"')
    entrada_excel = input("Caminho do Excel 'Apuracao-retidos.xlsx' (ou da pasta onde ele esta): ").strip().strip('"')
    pasta_raiz = Path(entrada_pasta).expanduser().resolve()
    caminho_excel_informado = Path(entrada_excel).expanduser().resolve()
    if not pasta_raiz.is_dir():
        print()
        print(f"Erro: pasta raiz nao encontrada: {pasta_raiz}")
        sys.exit(1)
    try:
        caminho_excel = resolver_caminho_excel(caminho_excel_informado)
        caminho_saida = executar(pasta_raiz, caminho_excel)
        print()
        print("Conferencia concluida com sucesso.")
        print(f"Arquivo gerado: {caminho_saida}")
    except Exception as erro:
        print()
        print(f"Erro: {erro}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
